RewriteEngine On
# InfinityFree runs PHP via CGI/FastCGI, which strips the Authorization
# header before PHP sees it. Without this, $_SERVER['HTTP_AUTHORIZATION']
# is always empty, so Bearer API keys are silently never read.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
# /article/123  ->  article.php?id=123
RewriteRule ^article/([0-9]+)/?$ article.php?id=$1 [L,QSA]
RewriteRule ^verify$ verify.php [L]
# Hide the .php extension on the homepage (optional, not required)
DirectoryIndex index.php
RewriteRule ^login/?$ signin.php [L,QSA]
RewriteRule ^logout/?$ signout.php [L,QSA]
RewriteRule ^register/?$ register.php [L,QSA]
RewriteRule ^signin/?$ signin.php [L,QSA]
RewriteRule ^signout/?$ signout.php [L,QSA]
RewriteRule ^delete-account/?$ delete_account.php [L,QSA]
RewriteRule ^users/([A-Za-z0-9_]+)/?$ profile.php?username=$1 [L,QSA]
RewriteRule ^@([A-Za-z0-9_]+)/?$ profile.php?username=$1 [L,QSA]
RewriteRule ^search$ search.php [L]
RewriteRule ^profiles/?$ profiles.php [L,QSA]
RewriteRule ^explore/?$ explore.php [L,QSA]

# Clean URLs: strip .php extension (top-level pages only, for now).
# Explicit rules, not a dynamic -f check — InfinityFree's setup makes
# both DOCUMENT_ROOT and REQUEST_FILENAME unreliable for filesystem
# existence checks, which caused 500s. These mirror the same pattern
# as the rules above, which are already proven to work on this host.
RewriteRule ^about/?$ about.php [L,QSA]
RewriteRule ^download/?$ download.php [L,QSA]
RewriteRule ^changelog/?$ changelog.php [L,QSA]
RewriteRule ^community-guidelines/?$ community-guidelines.php [L,QSA]
RewriteRule ^feedback/?$ feedback.php [L,QSA]
RewriteRule ^random-article/?$ random-article.php [L,QSA]
RewriteRule ^heartbeat/?$ heartbeat.php [L,QSA]
RewriteRule ^stop-impersonating/?$ stop-impersonating.php [L,QSA]
RewriteRule ^follow/?$ follow.php [L,QSA]
RewriteRule ^update-profile/?$ update-profile.php [L,QSA]
RewriteRule ^profile-comment/?$ profile-comment.php [L,QSA]
RewriteRule ^my-articles/?$ my-articles.php [L,QSA]
RewriteRule ^submit/?$ submit.php [L,QSA]
RewriteRule ^submission-guidelines/?$ submission-guidelines.php [L,QSA]
RewriteRule ^settings/?$ settings.php [L,QSA]
RewriteRule ^google-auth/?$ google-auth.php [L,QSA]
RewriteRule ^upload-image/?$ upload-image.php [L,QSA]
RewriteRule ^messages/?$ messages.php [L,QSA]
RewriteRule ^moderator/?$ moderator.php [L,QSA]

# Clean URLs: admin/ nested pages. Same explicit-hardcoded pattern as above
# (dynamic -f checks are unreliable on InfinityFree and caused 500s).
RewriteRule ^admin/banners/?$ admin/banners.php [L,QSA]
RewriteRule ^admin/create/?$ admin/create.php [L,QSA]
RewriteRule ^admin/delete/?$ admin/delete.php [L,QSA]
RewriteRule ^admin/edit/?$ admin/edit.php [L,QSA]
RewriteRule ^admin/feedback/?$ admin/feedback.php [L,QSA]
RewriteRule ^admin/impersonate/?$ admin/impersonate.php [L,QSA]
RewriteRule ^admin/impersonation-log/?$ admin/impersonation-log.php [L,QSA]
RewriteRule ^admin/moderation-words/?$ admin/moderation-words.php [L,QSA]
RewriteRule ^admin/move/?$ admin/move.php [L,QSA]
RewriteRule ^admin/reports/?$ admin/reports.php [L,QSA]
RewriteRule ^admin/stats/?$ admin/stats.php [L,QSA]
RewriteRule ^admin/submissions/?$ admin/submissions.php [L,QSA]
RewriteRule ^admin/sync-github/?$ admin/sync-github.php [L,QSA]
RewriteRule ^admin/upload-avatar/?$ admin/upload-avatar.php [L,QSA]
RewriteRule ^admin/upload-image/?$ admin/upload-image.php [L,QSA]
RewriteRule ^admin/users/?$ admin/users.php [L,QSA]
RewriteRule ^admin/visits/?$ admin/visits.php [L,QSA]
RewriteRule ^admin/autosave/?$ autosave.php [L,QSA]
RewriteRule ^submit-autosave/?$ submit-autosave.php [L,QSA]

<FilesMatch "\.(css|js|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>